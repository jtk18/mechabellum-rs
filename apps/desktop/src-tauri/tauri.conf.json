{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mechabellum Stats",
  "version": "0.1.0",
  "identifier": "com.jtk18.mechabellum-stats",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mechabellum Stats",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/art/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Stats from your Mechabellum replays",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MUQ5ODNDRDc0QkFCMzMKUldRenEwdlhQSmdkcE92eU9OZW1iV1BBbUtWd2lUN0V3OC9ucHhTcVJEeEFkSGVxUjJHSWNwYjkK",
      "endpoints": [
        "https://github.com/jtk18/mechabellum-rs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
